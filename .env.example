# Copy to .env; replace placeholders before running.
LLM_BASE_URL=http://YOUR_MODEL_SERVER:8000/v1
LLM_MODEL=YOUR_SERVED_MODEL_NAME
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=800
SEARCH_INTERVAL_SECONDS=3600
DAILY_EMAIL_LIMIT=5
SEND_EMAILS=false

# Host PDF path for Compose; default: beside Dockerfile. Never commit the CV.
RESUME_FILE=./resume.pdf
# Local Python default (Compose uses /app/resume.pdf internally).
RESUME_PATH=resume.pdf

# Internet search: configure your provider account separately.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_QUERIES_PER_RUN=6
SEARCH_MAX_PAGES_PER_RUN=10

# Set these on your server; do not commit .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SEND_EMAILS=true enables real delivery after SMTP settings are complete.
# Model API example: LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL must be a Chat Completions compatible model available to your account.
# LLM_API_KEY is the provider API key, not your ChatGPT subscription.

# Telegram: set up a bot using BotFather, then keep its token on the server.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEARCH_RUN_TIMEOUT_SECONDS=600
